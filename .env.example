# Supabase (Settings → API). Required for live site content and member auth.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only Google Drive upload settings. Never prefix these with VITE_.
GOOGLE_DRIVE_FOLDER_ID=1rJIHMxtvbK9qd9mxHdmNYADxbWEsihjB
GOOGLE_DRIVE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_DRIVE_REFRESH_TOKEN=your-google-oauth-refresh-token
DRIVE_UPLOAD_ALLOWED_ORIGIN=https://eyesclosed.love

# Auth redirect URLs (Supabase Dashboard → Authentication → URL configuration):
# - Site URL: your production origin (e.g. https://formless.example)
# - Redirect URLs: include /auth/callback on each origin you use
#   e.g. http://localhost:5173/auth/callback and https://formless.example/auth/callback
#
# Google sign-in (Supabase Dashboard → Authentication → Providers → Google):
# 1. Create an OAuth client in Google Cloud Console (Web application).
# 2. Authorized redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
# 3. Enable Google in Supabase and paste the client ID + secret.
# For local Supabase CLI, set SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID and
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET, then enable [auth.external.google] in config.toml.

# Optional: teaser-only mode. When "true", only home is shown and footer links are plain text.
# Auth routes (/login, /signup, /account) still work in restricted mode.
# Default (unset or any other value): full site with normal navigation.
# VITE_PUBLIC_SITE_RESTRICTED=true

# Optional: show Sign in / Account in the navigation. Default is off.
# Auth pages remain available at their URLs when this is unset.
# VITE_PUBLIC_MEMBER_AUTH_NAV=true

# Optional: local/dev only. Skip Brand Studio sign-in for MCP, screenshots, and UI checks.
# Hard-gated to the Vite DEV server; production builds never honor this flag.
# Alternate one-off: append ?bypassInternalAuth=1 while `npm run dev` is running.
# VITE_BYPASS_INTERNAL_AUTH=true

# Optional: show Formless book aside on home hero. Default is off.
# VITE_HERO_BOOK_ASIDE=true

# Optional: show the book cover block on /audio/editorial2. Default is off
# until cover artwork is approved. Preview with ?editorialBookCover=1
# VITE_EDITORIAL_BOOK_COVER=true
VITE_PUBLIC_POSTHOG_KEY=your-posthog-project-api-key
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional: set to "true" to disable client analytics (e.g. local dev)
# VITE_PUBLIC_POSTHOG_DISABLED=true
